APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-detector-secret-key

TARGET_URL=https://www.voyage.benin.bj
SCAN_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=30
ASSET_TIMEOUT_SECONDS=20
MAX_ASSETS_PER_TYPE=20
REQUEST_USER_AGENT=WebsiteChangeDetector/1.0
TIMEZONE=Europe/Paris
ENABLE_SCHEDULER=true
FETCH_LINKED_ASSETS=true
IGNORE_SYSTEM_PROXIES=true
RECORD_SCANS_WITHOUT_CHANGES=true

EMAIL_ENABLED=true
EMAIL_TO=your-recipient@gmail.com
EMAIL_FROM=your-sender@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password
